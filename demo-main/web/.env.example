# Data source: local | supabase | auto (auto = Supabase when both keys below are set, else offline demo data)
VITE_DATA_SOURCE=auto
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Care team AI plan (Weekly summary → Generate AI plan), read by the Vite server only, never sent to the browser.
# Free key from Google AI Studio (https://aistudio.google.com/apikey):
# GOOGLE_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# Or run Gemma on this computer with Ollama instead (no key): `ollama pull gemma3:4b`, then
# GEMMA_BACKEND=ollama
# OLLAMA_MODEL=gemma3:4b
